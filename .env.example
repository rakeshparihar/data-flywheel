DF_ENCODER=google/siglip-base-patch16-224
DF_DATASET=ashraq/fashion-product-images-small
DF_BASE_IMAGES=1500
DF_SEED=5
DF_CACHE_DIR=artifacts/embeddings
# Duplicate thresholds: pHash Hamming distance, embedding cosine similarity
DF_HASH_MAX_DISTANCE=8
DF_COSINE_MIN=0.92
# The two values above reproduce evals/RESULTS.md. evals/SWEEP.md found a better operating point on
# small catalog photos: DF_HASH_MAX_DISTANCE=2 with DF_COSINE_MIN=0.95 (precision 90.3%, recall 78.0%).
